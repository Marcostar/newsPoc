<?xml version="1.0" encoding="utf-8"?>
<!-- The reader's own API key is encrypted with a Keystore key that never leaves the phone, so a
     restored copy couldn't be read anyway. Keep it out of backups and transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="own_api_key.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="own_api_key.xml" />
    </device-transfer>
</data-extraction-rules>
